{
  "name": "civil-design-tool",
  "version": "0.1.0",
  "description": "Browser-based GIS+BIM road design tool for municipal projects (IFC 4.3, Statens vegvesen)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Philip-Hon-GIT/civil-design-tool.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/Philip-Hon-GIT/civil-design-tool/issues"
  },
  "homepage": "https://github.com/Philip-Hon-GIT/civil-design-tool#readme",
  "dependencies": {
    "@giro3d/giro3d": "^2.0.7",
    "ol": "~10.8.0",
    "proj4": "^2.23.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/proj4": "^2.5.6",
    "@types/three": "^0.180.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
